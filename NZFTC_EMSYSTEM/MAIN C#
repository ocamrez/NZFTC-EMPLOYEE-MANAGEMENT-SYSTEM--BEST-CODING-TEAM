    // VIEW EMPLOYEE INFORMATION
    static void ViewMyInformation(NpgsqlConnection conn, int userID)
    {
        string sql = @"
            SELECT u.Username, e.Salary, e.LeaveBalance
            FROM Users u
            JOIN Employees e ON u.UserID = e.UserID
            WHERE u.UserID = @userID;";

        using (var cmd = new NpgsqlCommand(sql, conn))
        {
            cmd.Parameters.AddWithValue("userID", userID);

            using (var reader = cmd.ExecuteReader())
            {
                if (reader.Read())
                {
                    string username = reader.GetString(0);
                    decimal salary = reader.GetDecimal(1);
                    decimal leaveBalance = reader.GetDecimal(2);

                    Console.WriteLine("\n===== MY INFORMATION =====");
                    Console.WriteLine("Username: " + username);
                    Console.WriteLine("Salary: $" + salary);
                    Console.WriteLine("Leave Balance: " + leaveBalance);
                }
                else
                {
                    Console.WriteLine("Employee information not found.");
                }
            }
        }
    }

