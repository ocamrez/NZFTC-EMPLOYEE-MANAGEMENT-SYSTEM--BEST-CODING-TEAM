    // LEAVE MANAGEMENT - ADMIN
    static void LeaveManagement(NpgsqlConnection conn)
    {
        Console.WriteLine("\n===== LEAVE MANAGEMENT =====");
        Console.WriteLine("1. View Leave Requests");
        Console.WriteLine("2. Approve Leave Request");
        Console.WriteLine("3. Reject Leave Request");
        Console.WriteLine("4. Set Leave Policy");

        Console.Write("Select an option: ");
        string choice = Console.ReadLine();

        if (choice == "1")
        {
            string sql = @"
                SELECT RequestID, UserID, StartDate,
                       EndDate, Reason, Status
                FROM LeaveRequests
                ORDER BY RequestID;";

            using (var cmd = new NpgsqlCommand(sql, conn))
            using (var reader = cmd.ExecuteReader())
            {
                while (reader.Read())
                {
                    Console.WriteLine("\nRequest ID: " + reader.GetInt32(0));
                    Console.WriteLine("Employee ID: " + reader.GetInt32(1));
                    Console.WriteLine("Start Date: " + reader.GetDateTime(2).ToShortDateString());
                    Console.WriteLine("End Date: " + reader.GetDateTime(3).ToShortDateString());
                    Console.WriteLine("Reason: " + reader.GetString(4));
                    Console.WriteLine("Status: " + reader.GetString(5));
                }
            }
        }
        else if (choice == "2" || choice == "3")
        {
            Console.Write("Enter leave Request ID: ");
            int requestID = int.Parse(Console.ReadLine());

            string status = choice == "2" ? "Approved" : "Rejected";

            string sql = @"
                UPDATE LeaveRequests
                SET Status = @status
                WHERE RequestID = @id AND Status = 'Pending';";

            using (var cmd = new NpgsqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("status", status);
                cmd.Parameters.AddWithValue("id", requestID);

                Console.WriteLine(cmd.ExecuteNonQuery() > 0
                    ? "Leave request " + status + "."
                    : "Pending leave request not found.");
            }
        }
        else if (choice == "4")
        {
            Console.Write("Enter policy name: ");
            string name = Console.ReadLine();

            Console.Write("Enter allowed leave days: ");
            int days = int.Parse(Console.ReadLine());

            Console.Write("Enter policy description: ");
            string description = Console.ReadLine();

            string sql = @"
                INSERT INTO LeavePolicies
                (PolicyName, DaysAllowed, Description)
                VALUES (@name, @days, @description);";

            using (var cmd = new NpgsqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("name", name);
                cmd.Parameters.AddWithValue("days", days);
                cmd.Parameters.AddWithValue("description", description);
                cmd.ExecuteNonQuery();
            }

            Console.WriteLine("Leave policy added.");
        }
        else
        {
            Console.WriteLine("Invalid option.");
        }
    }

    // EMPLOYEE APPLY FOR LEAVE
    static void ApplyForLeave(NpgsqlConnection conn, int userID)
    {
        Console.WriteLine("\n===== APPLY FOR LEAVE =====");

        Console.Write("Enter start date (YYYY-MM-DD): ");
        DateTime startDate = DateTime.Parse(Console.ReadLine());

        Console.Write("Enter end date (YYYY-MM-DD): ");
        DateTime endDate = DateTime.Parse(Console.ReadLine());

        Console.Write("Enter reason for leave: ");
        string reason = Console.ReadLine();

        if (endDate < startDate)
        {
            Console.WriteLine("End date cannot be before start date.");
            return;
        }

        string sql = @"
            INSERT INTO LeaveRequests
            (UserID, StartDate, EndDate, Reason, Status)
            VALUES (@userID, @startDate, @endDate, @reason, 'Pending');";

        using (var cmd = new NpgsqlCommand(sql, conn))
        {
            cmd.Parameters.AddWithValue("userID", userID);
            cmd.Parameters.AddWithValue("startDate", startDate);
            cmd.Parameters.AddWithValue("endDate", endDate);
            cmd.Parameters.AddWithValue("reason", reason);

            cmd.ExecuteNonQuery();
        }

        Console.WriteLine("Leave request submitted.");
    }

