    // PAYROLL MANAGEMENT - ADMIN
    static void PayrollManagement(NpgsqlConnection conn)
    {
        Console.WriteLine("\n===== PAYROLL MANAGEMENT =====");
        Console.WriteLine("1. Generate Employee Payslip");
        Console.WriteLine("2. View Payroll Reports");
        Console.WriteLine("3. Configure Default Tax Rate");

        Console.Write("Select an option: ");
        string choice = Console.ReadLine();

        if (choice == "1")
        {
            Console.Write("Enter employee User ID: ");
            int id = int.Parse(Console.ReadLine());

            string sql = @"
                SELECT Salary, TaxRate
                FROM Employees
                WHERE UserID = @id;";

            decimal salary;
            decimal taxRate;

            using (var cmd = new NpgsqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("id", id);

                using (var reader = cmd.ExecuteReader())
                {
                    if (!reader.Read())
                    {
                        Console.WriteLine("Employee not found.");
                        return;
                    }

                    salary = reader.GetDecimal(0);
                    taxRate = reader.GetDecimal(1);
                }
            }

            decimal tax = salary * taxRate / 100;
            decimal netSalary = salary - tax;

            string insert = @"
                INSERT INTO Payslips
                (UserID, PayDate, GrossSalary, TaxDeducted, NetSalary)
                VALUES (@id, CURRENT_DATE, @salary, @tax, @net);";

            using (var cmd = new NpgsqlCommand(insert, conn))
            {
                cmd.Parameters.AddWithValue("id", id);
                cmd.Parameters.AddWithValue("salary", salary);
                cmd.Parameters.AddWithValue("tax", tax);
                cmd.Parameters.AddWithValue("net", netSalary);

                cmd.ExecuteNonQuery();
            }

            Console.WriteLine("\n===== PAYSLIP GENERATED =====");
            Console.WriteLine("Gross Salary: $" + salary);
            Console.WriteLine("Tax Deducted: $" + tax);
            Console.WriteLine("Net Salary: $" + netSalary);
        }
        else if (choice == "2")
        {
            string sql = @"
                SELECT UserID, PayDate, GrossSalary,
                       TaxDeducted, NetSalary
                FROM Payslips
                ORDER BY PayDate DESC;";

            using (var cmd = new NpgsqlCommand(sql, conn))
            using (var reader = cmd.ExecuteReader())
            {
                while (reader.Read())
                {
                    Console.WriteLine("\nEmployee ID: " + reader.GetInt32(0));
                    Console.WriteLine("Pay Date: " + reader.GetDateTime(1).ToShortDateString());
                    Console.WriteLine("Gross Salary: $" + reader.GetDecimal(2));
                    Console.WriteLine("Tax: $" + reader.GetDecimal(3));
                    Console.WriteLine("Net Salary: $" + reader.GetDecimal(4));
                }
            }
        }
        else if (choice == "3")
        {
            Console.Write("Enter default tax rate (%): ");
            decimal rate = decimal.Parse(Console.ReadLine());

            if (rate < 0 || rate > 100)
            {
                Console.WriteLine("Invalid tax rate.");
                return;
            }

            string sql = @"
                UPDATE PayrollSettings
                SET DefaultTaxRate = @rate
                WHERE SettingID = 1;";

            using (var cmd = new NpgsqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("rate", rate);

                if (cmd.ExecuteNonQuery() == 0)
                {
                    string insert = @"
                        INSERT INTO PayrollSettings
                        (SettingID, DefaultTaxRate)
                        VALUES (1, @rate);";

                    using (var insertCmd = new NpgsqlCommand(insert, conn))
                    {
                        insertCmd.Parameters.AddWithValue("rate", rate);
                        insertCmd.ExecuteNonQuery();
                    }
                }
            }

            Console.WriteLine("Default tax rate updated.");
        }
        else
        {
            Console.WriteLine("Invalid option.");
        }
    }

